# Alpaca paper trading — the hackathon competition account.
# This account must be BRAND NEW and dedicated to this hackathon,
# with a starting balance of exactly $100,000. Reused accounts are
# not eligible for judging.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# The paper account ID. Ships in the submission — it is how judges
# pull our P&L. Get it with: alpaca account get --jq '.id'
ALPACA_ACCOUNT_ID=

# Featherless AI — partner tech, $25 credits per participant.
# Integrated tech is required to be eligible for partner prizes.
FEATHERLESS_API_KEY=

# ElevenLabs, for the demo narration. Optional: falls back to macOS `say`.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# NEVER set ALPACA_LIVE_TRADE. It routes orders to live money.
# The CLI defaults to paper. Leave it alone.
